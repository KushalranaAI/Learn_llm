# Copy this file to ".env" in the project root (next to package.json) and fill in the provider(s) you use.
# No restart needed: the relay re-reads .env on every request (press "Re-check .env" on the /ai page).
#
# These keys are read by the local app on YOUR computer (npm run dev / npm start) and attached to AI requests there
# (app/api/ai-server → lib/ai/relay.ts). The browser never receives them, nothing is stored in the browser, and nothing
# here is bundled into the app. Never rename them with a NEXT_PUBLIC_ prefix: that would publish them in the page's JavaScript.
# Only works when you run the app locally, not on the static GitHub Pages copy (npm run build:pages has no server).
#
# ".env" is git-ignored. Never commit it.

# Anthropic (Claude) - the tutor defaults to claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-5-5 also offered)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI (endpoint, deployment and key are all needed; the version is optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
